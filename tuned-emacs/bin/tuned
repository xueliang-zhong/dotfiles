#!/usr/bin/env bash
# tuned - install, run and check tuned-emacs without `just`.
#
# The `emacs-*` recipes in the dotfiles justfile are thin wrappers around
# this script, so a machine without `just` can do the same setup:
#
#   bash tuned-emacs/bin/tuned install
#   bash tuned-emacs/bin/tuned sync
#   bash tuned-emacs/bin/tuned doctor
#   bash tuned-emacs/bin/tuned test [NAME]
#   bash tuned-emacs/bin/tuned run [EMACS-ARGS...]
#   bash tuned-emacs/bin/tuned default|restore-spacemacs
#
# install/emacs-setup.sh is a compatibility shim for the old command names.
#
# Overrides: EMACS=/path/to/emacs, PROFILE=other, PROFILE_DIR=/some/dir,
#            DOTFILES=/path/to/dotfiles, TUNED_SKIP_DOTFILES=1 (skip env.sh),
#            TUNED_VERBOSE=1 (stream each setup step's output).
set -euo pipefail

script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
DOTFILES=${DOTFILES:-$(cd "$script_dir/../.." && pwd -P)}
EMACS=${EMACS:-emacs}
PROFILE=${PROFILE:-crafted}
PROFILES=${PROFILES:-${HOME:-$USERPROFILE}/.emacs-profiles}
PROFILE_DIR=${PROFILE_DIR:-$PROFILES/$PROFILE}

say() { printf '%s\n' "$*"; }
die() {
    printf 'tuned: %s\n' "$*" >&2
    exit 1
}

# Step headings for the multi-step setup commands.  Noisy commands run
# under `run_quiet'; the long package step prints its own
# package progress lines.  NO_COLOR turns the colours off.
progress_total=0
progress_done=0
progress_started=${SECONDS:-0}
progress_colors=0

progress_init() {
    progress_total=$1
    progress_done=0
    progress_started=${SECONDS:-0}
    progress_colors=0
    if [ -t 1 ] && [ "${TERM:-dumb}" != dumb ]; then
        progress_colors=1
    fi
}

progress_color() {
    [ "$progress_colors" = 1 ] && [ -z "${NO_COLOR+x}" ]
}

progress_fail() {
    local title=${1:-}
    if progress_color; then printf '\033[31m'; fi
    printf '[%d/%d] FAILED  %s\n' "$progress_done" "$progress_total" "$title"
    if progress_color; then printf '\033[0m'; fi
}

progress_step() {
    local title=$1
    shift
    progress_done=$((progress_done + 1))
    if progress_color; then
        printf '\033[1m[%d/%d]\033[0m %s\n' \
            "$progress_done" "$progress_total" "$title"
    else
        printf '[%d/%d] %s\n' "$progress_done" "$progress_total" "$title"
    fi
    if "$@"; then
        return 0
    else
        progress_fail "$title"
        return 1
    fi
}

progress_finish() {
    local message=${1:-Done} elapsed
    elapsed=$(( ${SECONDS:-0} - progress_started ))
    if progress_color; then
        printf '\033[1;32m%s\033[0m (%ss)\n' "$message" "$elapsed"
    else
        printf '%s (%ss)\n' "$message" "$elapsed"
    fi
}

# Run a step with only its own progress lines visible: init.el prints
# package counts when TUNED_PROGRESS is set, and emacs_batch hides
# the usual "Loading ..." / "Contacting host" messages.  TUNED_VERBOSE=1
# streams the full output instead.
run_progress() {
    if [ "${TUNED_VERBOSE:-0}" = 1 ]; then
        "$@"
    else
        TUNED_PROGRESS=1 "$@"
    fi
}

# Run a command with its output hidden; print the captured log only when it
# fails.  Setup uses this for the noisy steps (copying dotfiles, cloning,
# loading the profile and downloading packages).  TUNED_VERBOSE=1 streams it.
# The command runs in a subshell so a `die' inside it fails only this step:
# its message stays in the log and is printed below.
run_quiet() {
    local log status
    if [ "${TUNED_VERBOSE:-0}" = 1 ]; then
        "$@"
        return
    fi
    log=$(mktemp "${TMPDIR:-/tmp}/tuned-setup.XXXXXX" 2>/dev/null ||
        printf '%s' "${TMPDIR:-/tmp}/tuned-setup.$$.log")
    if ( "$@" ) >"$log" 2>&1; then
        rm -f "$log"
    else
        status=$?
        printf '\n--- output of the failed step ---\n' >&2
        cat "$log" >&2
        rm -f "$log"
        return "$status"
    fi
}

# Paths written into the stubs and passed to git must be ones native Emacs
# and Git for Windows understand: on Git Bash turn /c/Users/me into C:/Users/me,
# elsewhere keep the path as it is.
winpath() {
    if command -v cygpath >/dev/null 2>&1; then
        cygpath -m "$1"
    else
        printf '%s' "$1" | tr '\\' '/'
    fi
}

require_emacs() {
    command -v "$EMACS" >/dev/null 2>&1 ||
        die "emacs not found: put Emacs 30+ on PATH, or set EMACS=/path/to/emacs"
    local ver
    ver=$("$EMACS" --batch --eval '(princ emacs-major-version)' 2>/dev/null || true)
    [ "${ver:-0}" -ge 30 ] ||
        die "Need Emacs 30 or newer, found: ${ver:-none}"
}

require_profile() {
    [ -r "$PROFILE_DIR/init.el" ] ||
        die "no profile at $PROFILE_DIR; run: $0 crafted-install"
}

# Load the profile in batch exactly as a GUI start does: early-init, Crafted's
# before-init-hook, then init.el.  Any init error fails the command.
emacs_batch() {
    if [ "${TUNED_PROGRESS:-0}" = 1 ]; then
        # Setup asks init.el for compact progress lines; hide Emacs messages.
        "$EMACS" --batch --init-directory "$PROFILE_DIR" \
            --eval '(setq inhibit-message t)' \
            -l "$PROFILE_DIR/early-init.el" \
            --eval '(run-hooks (quote before-init-hook))' \
            -l "$PROFILE_DIR/init.el" "$@"
    else
        "$EMACS" --batch --init-directory "$PROFILE_DIR" \
            -l "$PROFILE_DIR/early-init.el" \
            --eval '(run-hooks (quote before-init-hook))' \
            -l "$PROFILE_DIR/init.el" "$@"
    fi
}

install_dotfiles() {
    if [ "${TUNED_SKIP_DOTFILES:-0}" = 1 ]; then
        say "Skipping the dotfiles install (TUNED_SKIP_DOTFILES=1)"
    else
        (cd "$DOTFILES" && bash env.sh)
    fi
}

write_profile_stubs() {
    local dir=$1 dotfiles=$2 src=$3
    {
        echo ';;; early-init.el -*- lexical-binding: t; -*-'
        echo ';; Generated by tuned-emacs/bin/tuned; edit tuned-emacs/ in dotfiles.'
        printf '(defvar tuned-dotfiles "%s/")\n' "$dotfiles"
        printf '(defvar tuned-crafted-home "%s/")\n' "$src"
        echo '(load (expand-file-name "tuned-emacs/early-init.el" tuned-dotfiles))'
    } >"$dir/early-init.el"
    {
        echo ';;; init.el -*- lexical-binding: t; -*-'
        echo ';; Generated by tuned-emacs/bin/tuned; edit tuned-emacs/ in dotfiles.'
        # TUNED_EXAMPLE=1 at crafted-install loads the author'"'"'s example/xueliang.el
        # instead of personal.el; see init.el.
        if [ "${TUNED_EXAMPLE:-}" = 1 ]; then
            echo '(setq tuned-load-example t)'
        fi
        echo '(load (expand-file-name "tuned-emacs/init.el" tuned-dotfiles))'
    } >"$dir/init.el"
}

# Clone Crafted Emacs at the locked commit and generate the profile stubs in DIR.
cmd_crafted_install() {
    local dir=${1:-$PROFILE_DIR}
    local lock="$DOTFILES/tuned-emacs/crafted.lock"
    local url rev src dotfiles
    [ -r "$lock" ] || die "cannot read $lock"
    # tr: a CRLF checkout (Git for Windows' default) leaves "\r" on the commit id
    read -r _ url rev < <(tr -d '\r' <"$lock")
    [ -n "$url" ] && [ -n "$rev" ] ||
        die "cannot read url and commit from $lock"

    dotfiles=$(winpath "$DOTFILES")
    src="$(winpath "$PROFILES")/src/crafted-emacs"
    dir=$(winpath "$dir")
    mkdir -p "$(dirname "$src")" "$dir"

    if [ ! -d "$src/.git" ]; then
        say "Cloning $url into $src"
        git clone --quiet "$url" "$src" ||
            die "git clone failed (network, proxy, or $src not writable)"
    fi
    git -C "$src" cat-file -e "$rev^{commit}" 2>/dev/null ||
        git -C "$src" fetch --quiet origin ||
        die "git fetch failed in $src"
    git -C "$src" checkout --quiet "$rev" ||
        die "cannot check out commit $rev in $src"

    write_profile_stubs "$dir" "$dotfiles" "$src"
    say "Crafted profile ready: $dir"
}

# Generate lisp/tuned-autoloads.el from the `;;;###autoload' cookies in lisp/.
# It is a generated file: init.el loads it instead of listing autoloads by
# hand, so a command's definition and its autoload cannot drift apart.
cmd_autoloads() {
    require_emacs
    local lisp="$DOTFILES/tuned-emacs/lisp"
    local output="$lisp/tuned-autoloads.el"
    # loaddefs-generate always writes its own standard preamble, which says
    # the file is part of GNU Emacs.  Generate the file normally, then keep
    # only the body after its Code marker and write our one header around it.
    "$EMACS" --batch -Q --eval "
(progn
  (require 'loaddefs-gen)
  (loaddefs-generate \"$lisp\" \"$output\" (list \"$output\") nil nil t)
  (with-temp-buffer
    (insert-file-contents \"$output\")
    (goto-char (point-min))
    (unless (search-forward \"\\n;;; Code:\\n\" nil t)
      (error \"tuned-autoloads: no Code marker in the generated file\"))
    (let ((body (buffer-substring (point) (point-max))))
      (with-temp-file \"$output\"
        (insert \";;; tuned-autoloads.el --- generated autoloads -*- lexical-binding: t; -*-\\n\"
                \";; Generated by bin/tuned sync; do not edit.\\n\\n\"
                \";;; Code:\\n\"
                body)))))"
}

cmd_smoke() {
    require_emacs
    require_profile
    emacs_batch --eval '(message "smoke ok: Emacs %s, %s" emacs-version user-emacs-directory)'
}

run_module_suite() {
    local suite=$1
    # Activate the profile's installed packages, so a module suite can require
    # the packages it integrates with (consult, evil, which-key).
    "$EMACS" --batch -Q -L "$DOTFILES/tuned-emacs/lisp" \
        --eval '(setq load-prefer-newer t)' \
        --eval "(setq package-user-dir (expand-file-name (format \"elpa-%d.%d\" emacs-major-version emacs-minor-version) \"$PROFILE_DIR\"))" \
        --eval '(package-activate-all)' \
        -l "$suite" \
        -f ert-run-tests-batch-and-exit
}

run_smoke_suite() {
    # Profile-level checks: keymaps, hooks and line counts.  The suite tests the
    # author's configuration, which lives in example/ and is not loaded by
    # default.  Load it after the profile, as personal.el would.
    emacs_batch --eval "(load \"$DOTFILES/tuned-emacs/example/xueliang.el\" nil t)" \
        -l "$DOTFILES/tuned-emacs/tests/smoke-tests.el" \
        -f ert-run-tests-batch-and-exit
}

cmd_test() {
    require_emacs
    require_profile
    local name=${1:-}
    if [ -n "$name" ]; then
        if [ "$name" = smoke ]; then
            run_smoke_suite
        else
            local base=${name#tuned-}
            local suite="$DOTFILES/tuned-emacs/tests/tuned-$base-tests.el"
            [ -r "$suite" ] || die "no test suite: $suite"
            run_module_suite "$suite"
        fi
        return 0
    fi
    # Every suite, with the profile-level checks first.  The module glob means
    # a new suite needs no change here.
    run_smoke_suite
    local suite
    for suite in "$DOTFILES"/tuned-emacs/tests/tuned-*-tests.el; do
        run_module_suite "$suite"
    done
}

# Byte-compile our own Lisp so it does not run interpreted.
# Runs with the profile loaded, so macros from installed packages (evil, ...)
# expand correctly; compiling in a bare batch Emacs would turn them into calls.
# Only files whose .el is newer than their .elc are compiled, so a second run
# compiles nothing.  Any failure makes the command fail.  No libgccjit needed.
cmd_compile_lisp() {
    require_emacs
    require_profile
    emacs_batch --eval "
(progn
  ;; Load bytecomp before binding its variables: a lexical binding made
  ;; before bytecomp is loaded makes its defvar fail on some builds (Windows).
  (require 'bytecomp)
  (let* ((dir (expand-file-name \"tuned-emacs\" \"$DOTFILES\"))
         (files (directory-files (expand-file-name \"lisp\" dir) t \"\\\\.el\\\\'\"))
         (done 0) (failed nil))
    (dolist (f files)
      (when (file-newer-than-file-p f (concat f \"c\"))
        (let ((byte-compile-verbose nil))
          (if (byte-compile-file f) (setq done (1+ done)) (push f failed)))))
    (when (equal (getenv \"TUNED_PROGRESS\") \"1\")
      (princ (format \"byte-compiled %d file(s)\\n\" done)))
    (when failed
      (message \"byte-compile failed: %S\" failed)
      (kill-emacs 1))))
"
}

# Record the installed version of every selected package in the profile, so
# `tuned doctor' can report drift after an archive update.
cmd_write_packages_lock() {
    require_emacs
    require_profile
    emacs_batch --eval '
(progn
  (require (quote package))
  (with-temp-file (expand-file-name "packages.lock" user-emacs-directory)
    (dolist (pkg (sort (copy-sequence package-selected-packages)
                       (function string<)))
      (let* ((desc (cadr (assq pkg package-alist)))
             (version (and desc (package-desc-version desc))))
        (when version
          (insert (format "%s %s\n" pkg (package-version-join version))))))))
'
}

# Report the ispell-compatible checker without failing the check.  See
# doc/tuned-consult-spell.md.
cmd_spell_check() {
    local found=0 program path
    for program in aspell hunspell ispell; do
        if path=$(command -v "$program" 2>/dev/null); then
            say "[spell] $program: $path"
            found=1
        fi
    done
    if [ "$found" -eq 0 ]; then
        say "[spell] no ispell-compatible checker found; install aspell or hunspell for tuned-consult-spell"
    fi
}

# Install missing packages, regenerate autoloads, byte-compile, build the
# trampolines and record the installed versions.
cmd_sync() {
    require_emacs
    require_profile
    progress_init 5
    progress_step "Generate autoloads" run_quiet cmd_autoloads
    progress_step "Install Emacs packages" run_progress cmd_smoke
    progress_step "Byte-compile own Lisp" run_quiet cmd_compile_lisp
    progress_step "Build trampolines" run_quiet cmd_trampolines
    progress_step "Write packages.lock" run_quiet cmd_write_packages_lock
    progress_finish "Sync complete"
}

cmd_check() {
    cmd_sync
    cmd_test
    cmd_spell_check
}

cmd_doctor() {
    require_emacs
    require_profile
    run_progress emacs_batch \
        -l "$DOTFILES/tuned-emacs/lisp/tuned-doctor.el" \
        --eval '(tuned-doctor-batch)'
}

cmd_install() {
    case "$(uname -s)" in
        Darwin) cmd_setup_macos ;;
        Linux) cmd_setup_linux ;;
        MINGW* | MSYS* | CYGWIN*) cmd_setup_windows ;;
        *) die "no install steps for $(uname -s)" ;;
    esac
}

cmd_upgrade() {
    require_emacs
    say "Pulling $DOTFILES"
    git -C "$DOTFILES" pull --ff-only || die "git pull failed"
    cmd_crafted_install "$PROFILE_DIR"
    cmd_sync
}

# When config advises a C primitive (evil: select-window, read-key-sequence,
# ...), a native-built Emacs compiles a trampoline for it on the main thread,
# about 1 s each, if none is cached: a cold cache gave a white frame for 12 s.
# This loads the profile (so it is a smoke test too), then runs the idle-timer
# loads (org, magit, eshell, diff-hl, ...) so their advice gets a trampoline.
cmd_trampolines() {
    require_emacs
    require_profile
    emacs_batch --eval '
(if (not (native-comp-available-p))
    (if (equal (getenv "TUNED_PROGRESS") "1")
        (princ "trampolines: native compilation not available\n")
      (message "profile ok; this Emacs has no native compilation, so no trampolines to build"))
  (let ((timers (copy-sequence timer-idle-list))
        (total (length timer-idle-list))
        (index 0))
    (dolist (timer timers)
      (setq index (1+ index))
      (when (equal (getenv "TUNED_PROGRESS") "1")
        (princ (format "trampolines %d/%d\n" index total)))
      (ignore-errors (timer-event-handler timer)))
    (let ((count (length (directory-files (expand-file-name comp-native-version-dir (car native-comp-eln-load-path)) nil "\\`subr--trampoline-"))))
      (if (equal (getenv "TUNED_PROGRESS") "1")
          (princ (format "trampolines cached: %d\n" count))
        (message "profile ok; subr trampolines cached: %d" count)))))
'
}

# Spacemacs' ~/.emacs.d moves to ~/.emacs-profiles/spacemacs (nothing deleted).
cmd_make_default() {
    case "$(uname -s)" in
        MINGW* | MSYS* | CYGWIN*) die "On Windows use: $0 setup-windows" ;;
    esac
    if [ -L "$HOME/.emacs.d" ]; then
        local target
        target=$(readlink "$HOME/.emacs.d")
        [ "$target" = "$PROFILE_DIR" ] && { say "~/.emacs.d already points to Crafted"; return 0; }
        die "~/.emacs.d is a link to $target, stop"
    fi
    if pgrep -f "Emacs.app/Contents/MacOS|bin/emacs" >/dev/null; then
        die "quit all Emacs first"
    fi
    if [ -e "$HOME/.emacs.d" ]; then
        [ -e "$PROFILES/spacemacs" ] && die "$PROFILES/spacemacs exists, stop"
        mv "$HOME/.emacs.d" "$PROFILES/spacemacs"
        say "Moved ~/.emacs.d to $PROFILES/spacemacs"
    fi
    ln -s "$PROFILE_DIR" "$HOME/.emacs.d"
    say "Default Emacs now starts Crafted (~/.emacs.d -> $PROFILE_DIR)"
}

# Undo cmd_make_default: put Spacemacs back as ~/.emacs.d.
cmd_restore_spacemacs() {
    [ -L "$HOME/.emacs.d" ] || die "~/.emacs.d is not a link to Crafted, stop"
    [ -d "$PROFILES/spacemacs" ] || die "no $PROFILES/spacemacs, stop"
    rm "$HOME/.emacs.d"
    mv "$PROFILES/spacemacs" "$HOME/.emacs.d"
    say "Spacemacs restored as ~/.emacs.d"
}

# Loading the profile installs missing packages and is the smoke test; the
# trampoline step is a separate load so each phase has its own title.
cmd_setup_macos() {
    [ "$(uname -s)" = Darwin ] ||
        die "run this on macOS; on Linux use install, on Windows install"
    progress_init 8
    progress_step "Install dotfiles" run_quiet install_dotfiles
    progress_step "Crafted profile" run_quiet cmd_crafted_install "$PROFILE_DIR"
    progress_step "Install Emacs packages" run_progress cmd_smoke
    progress_step "Generate autoloads" run_quiet cmd_autoloads
    progress_step "Byte-compile own Lisp" run_quiet cmd_compile_lisp
    progress_step "Build trampolines" run_quiet cmd_trampolines
    progress_step "Write packages.lock" run_quiet cmd_write_packages_lock
    progress_step "Make Crafted the default Emacs" cmd_make_default
    progress_finish "macOS setup complete"
}

cmd_setup_linux() {
    case "$(uname -s)" in
        Linux) ;;
        Darwin) die "run this on Linux; on macOS use install" ;;
        MINGW* | MSYS* | CYGWIN*) die "run this in Linux; on Windows use install" ;;
        *) die "no setup for $(uname -s)" ;;
    esac
    progress_init 8
    progress_step "Install dotfiles" run_quiet install_dotfiles
    progress_step "Crafted profile" run_quiet cmd_crafted_install "$PROFILE_DIR"
    progress_step "Install Emacs packages" run_progress cmd_smoke
    progress_step "Generate autoloads" run_quiet cmd_autoloads
    progress_step "Byte-compile own Lisp" run_quiet cmd_compile_lisp
    progress_step "Build trampolines" run_quiet cmd_trampolines
    progress_step "Write packages.lock" run_quiet cmd_write_packages_lock
    progress_step "Make Crafted the default Emacs" cmd_make_default
    progress_finish "Linux setup complete"
}

cmd_windows_check() {
    require_emacs
    say "Emacs $("$EMACS" --batch --eval '(princ emacs-version)')"
}

# Started from the Start menu, Emacs uses %HOME% as ~ and falls back to
# %APPDATA% when it is unset; pin it to the profile folder Git Bash uses.
cmd_windows_pin_home() {
    if command -v powershell.exe >/dev/null 2>&1; then
        local userhome
        userhome=$(powershell.exe -NoProfile -Command "[Environment]::GetEnvironmentVariable('HOME','User')" | tr -d '\r')
        if [ -z "$userhome" ]; then
            setx HOME "$(cygpath -w "$HOME")" >/dev/null
            say "Set user variable HOME=$(cygpath -w "$HOME") (programs started from now on see it)"
        fi
    fi
}

# Emacs prefers ~/.emacs and ~/.emacs.el over ~/.emacs.d; move old setups aside
cmd_windows_move_old_configs() {
    local backup f
    backup="$PROFILES/backup-$(date +%Y%m%d-%H%M%S)"
    for f in .emacs .emacs.el .emacs.d; do
        [ -e "$HOME/$f" ] || continue
        grep -qsE "Generated by (just emacs-crafted-install|tuned-emacs/(bin/tuned|install/emacs-setup\.sh))" \
            "$HOME/$f/init.el" && continue
        mkdir -p "$backup"
        mv "$HOME/$f" "$backup/"
        say "Moved ~/$f to $backup"
    done
}

# Installs Crafted straight into ~/.emacs.d (Git Bash `ln -s` copies instead
# of linking), sets the HOME user variable so Start-menu Emacs finds it, moves
# any old ~/.emacs, ~/.emacs.el, ~/.emacs.d aside, then installs packages.
cmd_setup_windows() {
    case "$(uname -s)" in
        MINGW* | MSYS* | CYGWIN*) ;;
        *) [ -n "${TUNED_FORCE_WINDOWS:-}" ] || die "run this from Git Bash on Windows" ;;
    esac
    local d
    progress_init 9
    progress_step "Check Emacs" cmd_windows_check
    progress_step "Pin HOME for Start-menu Emacs" cmd_windows_pin_home
    progress_step "Move old configurations aside" cmd_windows_move_old_configs
    d=$(winpath "$HOME/.emacs.d")
    progress_step "Crafted profile" run_quiet cmd_crafted_install "$d"
    PROFILE_DIR="$d" progress_step "Install Emacs packages" run_progress cmd_smoke
    progress_step "Generate autoloads" run_quiet cmd_autoloads
    PROFILE_DIR="$d" progress_step "Byte-compile own Lisp" run_quiet cmd_compile_lisp
    PROFILE_DIR="$d" progress_step "Build trampolines" run_quiet cmd_trampolines
    PROFILE_DIR="$d" progress_step "Write packages.lock" run_quiet cmd_write_packages_lock
    progress_finish "Done. Start Emacs from the Start menu or run: runemacs"
}

cmd_try() {
    require_emacs
    require_profile
    "$EMACS" --init-directory "$PROFILE_DIR" "$@" &
}

usage() {
    cat <<'EOF'
usage: tuned COMMAND [ARGS]

install:
  install                install dotfiles + Crafted profile, make it ~/.emacs.d
  sync                   install packages, autoloads, byte-compile, trampolines,
                         write packages.lock
  doctor                 explain what is wrong on this machine
  test [NAME]            run every ERT suite, or tests/tuned-NAME-tests.el
  upgrade                pull the dotfiles, move Crafted to the new pin, sync

use:
  run [ARGS]             start Emacs with the profile, passing ARGS through
  default                point ~/.emacs.d at the profile (Spacemacs moves aside)
  restore-spacemacs      undo default

compatibility (install/emacs-setup.sh):
  crafted-install [DIR]  clone Crafted at the locked commit, write stubs
  smoke                  load the profile in batch; fails on any init error
  autoloads              regenerate lisp/tuned-autoloads.el from lisp/
  check                  sync + test + spell check
  trampolines            pre-build advice trampolines so a GUI start is fast
  compile-lisp           byte-compile our own lisp/ where stale
  setup-macos            old name for install on macOS
  setup-linux            old name for install on Linux
  setup-windows          old name for install on Windows
  try                    old name for run
  make-default           old name for default

environment: EMACS, PROFILE, PROFILES, PROFILE_DIR, DOTFILES,
             TUNED_SKIP_DOTFILES=1 (skip env.sh), TUNED_FORCE_WINDOWS=1,
             TUNED_VERBOSE=1 (show each step's output; setup hides it by default)
EOF
}

case "${1:-}" in
    install) shift; cmd_install "$@" ;;
    sync) shift; cmd_sync "$@" ;;
    doctor) shift; cmd_doctor "$@" ;;
    test) shift; cmd_test "$@" ;;
    upgrade) shift; cmd_upgrade "$@" ;;
    run) shift; cmd_try "$@" ;;
    default) shift; cmd_make_default "$@" ;;
    restore-spacemacs) shift; cmd_restore_spacemacs "$@" ;;
    # Compatibility names, kept for install/emacs-setup.sh and old habits.
    crafted-install) shift; cmd_crafted_install "$@" ;;
    smoke) shift; cmd_smoke "$@" ;;
    autoloads) shift; cmd_autoloads "$@" ;;
    check) shift; cmd_check "$@" ;;
    trampolines) shift; cmd_trampolines "$@" ;;
    compile-lisp) shift; cmd_compile_lisp "$@" ;;
    make-default) shift; cmd_make_default "$@" ;;
    setup-macos) shift; cmd_setup_macos "$@" ;;
    setup-linux) shift; cmd_setup_linux "$@" ;;
    setup-windows) shift; cmd_setup_windows "$@" ;;
    try) shift; cmd_try "$@" ;;
    help | -h | --help) usage ;;
    *) usage; exit 2 ;;
esac
