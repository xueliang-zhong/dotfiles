<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Written by emacs-setup.sh jit-schedule from xl-jit.plist.in.  Do not edit
     the installed copy: change the template and run jit-schedule again. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.xl-jit</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>@DOTFILES@/emacs/install/emacs-setup.sh</string>
        <string>jit-scheduled</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>EMACS</key>
        <string>@EMACS@</string>
        <key>PROFILE_DIR</key>
        <string>@PROFILE_DIR@</string>
        <key>DOTFILES</key>
        <string>@DOTFILES@</string>
    </dict>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>4</integer>
        <key>Minute</key>
        <integer>17</integer>
    </dict>
    <key>ProcessType</key>
    <string>Background</string>
    <key>LowPriorityIO</key>
    <true/>
    <key>Nice</key>
    <integer>19</integer>
    <key>StandardOutPath</key>
    <string>@PROFILE_DIR@/xl-jit/scheduled.log</string>
    <key>StandardErrorPath</key>
    <string>@PROFILE_DIR@/xl-jit/scheduled.log</string>
</dict>
</plist>
