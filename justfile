###########################
# emacs & nvim config files
###########################

all: install maintenance-check # docker-build
make: all

list:
    @echo just get familiar with justfile for this project
    just --list

install:
    @ls -l ~/.config/nvim/init.lua
    @ls -l ~/.vimrc
    @bash env.sh
    @echo "Scripts Installed"

maintenance-check:
  @echo "maintenance check of vimrc/init.lua/spacemacs"
  @echo "vimrc (goal <= 250 LOC):" && wc -l vimrc
  @echo "init.lua (goal <= 250 LOC):" && wc -l init.lua
  @echo "emacs config (goal <= 200 LOC):"
  @grep -v "^[ ]*;" spacemacs.el | grep -v "^[ ]*$" | grep -A 1000 "defun.*dotspacemacs/user-config" | wc -l

emacs-dotfiles-clean:
  # make sure no other emacs files under $HOME
  rm -rf ~/.emacs.d
  rm -rf ~/.emacs*
  rm -rf ~/.spacemacs*
  rm -rf ~/.config/emacs

doom-emacs-install:
  # standard installation
  git clone --depth 1 https://github.com/doomemacs/doomemacs ~/.config/emacs
  ~/.config/emacs/bin/doom install
  # a must step after installation
  ~/.config/emacs/bin/doom sync

spacemacs-install:
  # to be safe, not depending on emacs-dotfiles-clean
  git clone https://github.com/syl20bnr/spacemacs ~/.emacs.d

###########################
# Emacs profiles: try before buy
# Each profile is its own init directory under ~/.emacs-profiles and is
# started with --init-directory, so it never touches ~/.emacs.d (Spacemacs).
# Try another Emacs binary with: EMACS=/path/to/emacs just emacs-try
###########################

EMACS := env_var_or_default("EMACS", "emacs")
PROFILES := env_var("HOME") / ".emacs-profiles"

# clone Crafted Emacs at the locked commit and generate the profile stubs
emacs-crafted-install:
    #!/bin/bash
    set -e
    read -r _ url rev < emacs/frameworks.lock
    src="{{PROFILES}}/src/crafted-emacs"
    dir="{{PROFILES}}/crafted"
    mkdir -p "{{PROFILES}}/src" "$dir"
    [ -d "$src/.git" ] || git clone --quiet "$url" "$src"
    git -C "$src" checkout --quiet "$rev"
    {
        echo ';;; early-init.el -*- lexical-binding: t; -*-'
        echo ';; Generated by just emacs-crafted-install; edit emacs/crafted/ in dotfiles.'
        echo '(defvar xl-dotfiles "{{justfile_directory()}}/")'
        echo "(defvar xl-crafted-home \"$src/\")"
        echo '(load (expand-file-name "emacs/crafted/early-init.el" xl-dotfiles))'
    } > "$dir/early-init.el"
    {
        echo ';;; init.el -*- lexical-binding: t; -*-'
        echo ';; Generated by just emacs-crafted-install; edit emacs/crafted/ in dotfiles.'
        echo '(load (expand-file-name "emacs/crafted/init.el" xl-dotfiles))'
    } > "$dir/init.el"
    echo "Crafted profile ready: $dir"

# start a profile next to the default Emacs, e.g. `just emacs-try crafted`
emacs-try profile="crafted":
    {{EMACS}} --init-directory {{PROFILES}}/{{profile}} &

# load a profile in batch mode; fails on any init error
emacs-smoke profile="crafted":
    {{EMACS}} --batch --init-directory {{PROFILES}}/{{profile}} \
      -l {{PROFILES}}/{{profile}}/early-init.el --eval '(run-hooks (quote before-init-hook))' \
      -l {{PROFILES}}/{{profile}}/init.el --eval '(message "smoke ok: Emacs %s, %s" emacs-version user-emacs-directory)'

###########################
# Docker Environment
###########################

IMAGE := "ubuntu:24.04"
CONTAINER := "ubuntu-24.04-container"

docker-build:
    docker build -t {{IMAGE}} .

docker-run:
    docker run -it --name {{CONTAINER}} -v ~/workspace:/home/xuezho01/workspace {{IMAGE}}

docker-attach:
    docker exec -it {{CONTAINER}} zsh

docker-clean:
    docker stop {{CONTAINER}}
    docker rm   {{CONTAINER}}
